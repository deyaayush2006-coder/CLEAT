# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Cleat refuses to start unless this is exactly "sandbox".
PAYPAL_ENV=sandbox
# developer.paypal.com > Apps & Credentials > Sandbox > Create App (type: Merchant)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Optional demo limits. Each agent run makes about 5 Gemini calls; keep runs per day x 5 under your RPD.
AGENT_RUNS_PER_HOUR=10
AGENT_RUNS_PER_DAY=40
# Optional. Defaults to SQLite at data/cleat.db; set a postgresql+psycopg:// URL for Postgres.
# DATABASE_URL=
